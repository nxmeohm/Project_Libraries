%% =====================================================================
%% 1. DFD Level 0: Context Diagram (ตามรูปภาพตัวอย่างที่ 1)
%% =====================================================================

flowchart TD
    %% External Entities
    Admin["ผู้ดูแลระบบ (Admin)"]
    Member["สมาชิก"]
    User["ผู้ใช้งานทั่วไป"]

    %% Process 0
    P0[["0<br/>ระบบสารสนเทศยืม-คืน วัสดุและครุภัณฑ์"]]

    %% Flows: Admin <--> Process 0
    Admin -->|"- ข้อมูลการสมัครสมาชิก<br/>- ข้อมูลสมาชิก<br/>- ข้อมูลการยืม / การคืน<br/>- ข้อมูลสต๊อก<br/>- ข้อมูลอุปกรณ์พร้อมใช้ / ชำรุด / สูญหาย<br/>- ข้อมูลประวัติการซ่อม<br/>- ข้อมูลที่ต้องปรับปรุง"| P0
    P0 -->|"- เรียกดูข้อมูล: สมัครสมาชิก, สมาชิก, ยืม-คืน, สต๊อก, สถานะอุปกรณ์, ประวัติการซ่อม<br/>- ข้อมูลรายงานสรุปทุกประเภท"| Admin

    %% Flows: สมาชิก <--> Process 0
    Member -->|"- ข้อมูลสมาชิก / เข้าสู่ระบบ<br/>- ข้อมูลการยืม / ข้อมูลการคืน<br/>- ข้อมูลการติดตาม (จองคิว)<br/>- ข้อมูลแจ้งอุปกรณ์ชำรุด/สูญหาย"| P0
    P0 -->|"- ยืนยันการทำรายการยืม-คืน<br/>- ข้อมูลสถานะอุปกรณ์และสต๊อก<br/>- ข้อมูลการแจ้งเตือนคิว/หมดอายุ<br/>- ข้อมูลประวัติการยืมคืนส่วนบุคคล"| Member

    %% Flows: ผู้ใช้งาน <--> Process 0
    User -->|"ข้อมูลรายละเอียดสมัครสมาชิก"| P0
    P0 -->|"ข้อมูลผลการสมัครสมาชิก"| User


%% =====================================================================
%% 2. DFD Level 1: Overview Diagram (ตามรูปภาพตัวอย่างที่ 2)
%% =====================================================================

flowchart TD
    %% Entities
    User["ผู้ใช้งาน"]
    Member["สมาชิก"]
    Admin["ผู้ดูแลระบบ"]

    %% Processes 1 to 7
    P1[["1<br/>เข้าสู่ระบบ"]]
    P2[["2<br/>จัดการข้อมูล"]]
    P3[["3<br/>ยืม - คืนอุปกรณ์"]]
    P4[["4<br/>สต๊อกอุปกรณ์"]]
    P5[["5<br/>รายการสถานะอุปกรณ์"]]
    P6[["6<br/>ประวัติการซ่อม"]]
    P7[["7<br/>รายงานสรุป"]]

    %% Data Stores
    D1[("D1 ข้อมูลสมาชิก")]
    D2[("D2 ข้อมูลวัสดุ-ครุภัณฑ์")]
    D3[("D3 ข้อมูลการยืม")]
    D4[("D4 ข้อมูลการติดตาม (คิว)")]
    D5[("D5 ข้อมูลสถานะอุปกรณ์")]
    D6[("D6 ข้อมูลการคืน")]
    D7[("D7 ข้อมูลสต๊อก")]
    D8[("D8 ข้อมูลประวัติการซ่อม")]
    D10[("D10 ข้อมูลอุปกรณ์พร้อมใช้งาน / สูญหาย")]
    D11[("D11 ข้อมูลอุปกรณ์ชำรุด")]

    %% Process 1: เข้าสู่ระบบ
    User -->|"ข้อมูลสมัครสมาชิก / รายละเอียด"| P1
    P1 -->|"ข้อมูลผลการสมัครสมาชิก"| User
    Member -->|"ข้อมูลสมาชิก / ชื่อผู้ใช้และรหัสผ่าน"| P1
    P1 -->|"ข้อมูลยืนยันตัวตนเข้าใช้งาน"| Member
    P1 <-->|"บันทึก / ตรวจสอบข้อมูลสมาชิก"| D1

    %% Process 2: จัดการข้อมูล
    Member <-->|"ข้อมูลที่ต้องปรับปรุง / ข้อมูลที่ปรับปรุงแล้ว"| P2
    P2 <-->|"บันทึก / แก้ไขข้อมูลวัสดุ"| D2
    P2 <-->|"บันทึก / แก้ไขข้อมูลการยืม"| D3
    P2 <-->|"บันทึก / แก้ไขข้อมูลสต๊อก"| D7
    P2 <-->|"บันทึก / แก้ไขสถานะอุปกรณ์"| D5

    %% Process 3: ยืม - คืนอุปกรณ์
    Member -->|"ข้อมูลการยืม / บันทึกขอยืม"| P3
    P3 -->|"ผลการยืม / อนุมัติยืม"| Member
    Member -->|"ข้อมูลการคืน / บันทึกการคืน"| P3
    P3 -->|"ผลการรับคืน / ค่าปรับ (ถ้ามี)"| Member
    Member <-->|"ข้อมูลการติดตาม / จองคิว"| P3
    P3 <-->|"บันทึก / เรียกดูข้อมูลการยืม"| D3
    P3 <-->|"บันทึก / เรียกดูข้อมูลการติดตาม"| D4
    P3 <-->|"บันทึก / เรียกดูข้อมูลการคืน"| D6

    %% Process 4: สต๊อกอุปกรณ์
    P3 -.->|"อัปเดตสต๊อกเมื่อยืม-คืน"| P4
    Member <-->|"เรียกดูสต๊อก / บันทึกสต๊อก"| P4
    P4 <-->|"บันทึก / แก้ไข / เรียกดูสต๊อก"| D7
    P4 --> P5

    %% Process 5: รายการสถานะอุปกรณ์
    Member <-->|"อุปกรณ์พร้อมใช้งาน / ชำรุด / สูญหาย"| P5
    P5 <-->|"อุปกรณ์พร้อมใช้งาน"| D10
    P5 <-->|"อุปกรณ์ชำรุด"| D11

    %% Process 6: ประวัติการซ่อม
    Admin <-->|"บันทึก / เรียกดูข้อมูลประวัติการซ่อม"| P6
    P5 -.->|"ส่งอุปกรณ์ชำรุดเข้าซ่อม"| P6
    P6 <-->|"บันทึก / เรียกดูประวัติการซ่อม"| D8

    %% Process 7: รายงานสรุป
    Admin -->|"เรียกดูข้อมูลรายงานสรุปทุกประเภท"| P7
    P7 -->|"ส่งออกรายงานสรุป"| Admin
    D2 -.-> P7
    D3 -.-> P7
    D6 -.-> P7
    D4 -.-> P7
    D5 -.-> P7
    D7 -.-> P7
    D8 -.-> P7
