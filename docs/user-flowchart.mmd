%% =====================================================================
%% ผังงานฝั่งผู้ใช้งาน: เฉพาะขั้นตอนตรวจเช็คสถานะอุปกรณ์ (ยืม & จองคิว)
%% นำโค้ดด้านล่างนี้ไปวางที่ https://mermaid.live
%% =====================================================================

%%{init: {'theme': 'neutral'}}%%
flowchart TD
    %% จุดเริ่มต้น: ตรวจเช็คสถานะอุปกรณ์
    CheckStock{"ตรวจเช็คสถานะอุปกรณ์"}
    
    %% ==========================================
    %% สาขาที่ 1: การยืมอุปกรณ์ (มีของในสต๊อก)
    %% ==========================================
    CheckStock -- "มีอุปกรณ์ว่าง" --> BorrowForm[\กรอกข้อมูลการยืม/]
    BorrowForm --> SendBorrow[/"ส่งคำขอยืม (Pending 15 นาที)"/]
    SendBorrow --> WaitApprove{"รออนุมัติยืม / สแกน QR"}
    
    WaitApprove -- "ผ่าน" --> ReceiveItem["รับพัสดุ / สถานะ Borrowed"]
    WaitApprove -- "ไม่ผ่าน / เกิน 15 นาที" --> CancelBorrow["ยกเลิกคำขอยืม / คืนสต๊อก"]
    
    %% ==========================================
    %% สาขาที่ 2: การจองคิวอุปกรณ์ (ของหมดสต๊อก)
    %% ==========================================
    CheckStock -- "อุปกรณ์หมด (สต๊อก 0)" --> QueueForm[\กรอกข้อมูลจองคิว/]
    QueueForm --> SendQueue[/"ส่งคำขอยืนยันคิว (Waiting)"/]
    SendQueue --> WaitQueue{"รอการเรียกคิวเมื่อมีของคืน"}
    
    WaitQueue -- "ถึงคิวแล้ว (Called)" --> CheckTimer{"มารับภายใน 5 นาที?"}
    CheckTimer -- "ทันเวลา" --> ReceiveQueue["รับพัสดุ / คิว Completed"]
    CheckTimer -- "ไม่ทันเวลา" --> ExpireQueue["คิวหมดอายุ / ข้ามคิว"]
