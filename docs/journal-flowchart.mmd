flowchart TD
    Start([เข้าสู่ระบบ ผู้ใช้งานระบบ]) --> Login[/Login เข้าสู่ระบบ/]
    Login --> CheckUser{"ตรวจสอบข้อมูลสมาชิก"}
    
    %% ตรวจสอบข้อมูลสมาชิก
    CheckUser -- "ไม่ถูกต้อง" --> EditUser[\แก้ไขข้อมูล/]
    EditUser --> CheckHistory
    CheckUser -- "ถูกต้อง" --> CheckHistory{"ตรวจสอบประวัติการยืมคืน"}
    
    %% ตรวจสอบประวัติการยืมคืน
    CheckHistory -- "ไม่ต้องยืม" --> Logout([ออกจากระบบ])
    CheckHistory -- "ต้องการยืม" --> FormBorrow[\กรอกข้อมูลการยืม/]
    
    %% ยื่นคำขอยืม
    FormBorrow --> SendBorrow[/ส่งคำขอยืม/]
    SendBorrow --> WaitApprove{"รออนุมัติยืม"}
    
    %% ผลการอนุมัติ
    WaitApprove -- "ไม่ผ่าน" --> Cancel["ยกเลิกคำขอ / ลองใหม่"] --> FormBorrow
    WaitApprove -- "ผ่าน" --> Receive["รับพัสดุ"]
    Receive --> Logout
